# Shopee Philippines setup. Copy to .env; never commit your .env.
# Without configuration the source retains upstream Indonesian defaults.
SHOPEE_DOMAIN=shopee.ph
SHOPEE_LOCALE=en-PH
SHOPEE_TIMEZONE=Asia/Manila

# Before login, uncomment ONE path and replace YOUR_USER with your username.
# Use the SAME absolute path in the MCP client's env block.
# Keep the profile outside the checkout. ~ and environment variables are not expanded.
# SHOPEE_PROFILE_DIR=C:/Users/YOUR_USER/.shopee-mcp/chrome-profile-ph
# SHOPEE_PROFILE_DIR=/home/YOUR_USER/.shopee-mcp/chrome-profile-ph
# Unset source default: ~/.shopee-mcp/chrome-profile (shared across regions).

# A visible desktop or a virtual display is required.
SHOPEE_HEADLESS=false

# off: product discovery only, including when logged in.
# auto: enable private account reads and account-changing tools after login.
# The source default is auto; this example explicitly chooses off.
SHOPEE_ACCOUNT_TOOLS=off
CACHE_TTL_MS=30000
DEBUG=false
